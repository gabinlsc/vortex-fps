# Server reads environment variables; load this file through your process supervisor.
PORT=8080
HOST=0.0.0.0
MATCH_ID=local-match
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# At least 32 cryptographically random bytes, shared only with ticket issuer.
TICKET_SECRET=
AGONES=false
DATABASE_URL=postgresql://vortex:change-me@localhost:5432/vortex
# API requires OIDC issuer, audience and JWKS verification before public exposure.
