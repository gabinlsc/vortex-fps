{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "allowImportingTsExtensions": true,
    "noEmit": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "lib": ["ES2022", "DOM"], "types": ["node", "vite/client"]
  },
  "include": ["shared", "client", "server", "api", "tests"]
}
