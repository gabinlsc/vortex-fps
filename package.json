{
  "name": "vortex-fps",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server:dev": "tsx server/main.ts --local-dev",
    "server": "tsx server/main.ts",
    "test": "node --experimental-transform-types --test tests/core.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts tests/network.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/main.mjs",
    "api": "tsx api/main.ts",
    "prisma:generate": "prisma generate --schema api/schema.prisma",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "play": "node scripts/play.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.180.0",
    "flatbuffers": "25.9.23",
    "ws": "8.18.3",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.16.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "jose": "6.1.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "@types/express": "5.0.3",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "vite": "7.1.7",
    "esbuild": "0.25.10",
    "prisma": "6.16.2",
    "@playwright/test": "1.55.1"
  }
}
